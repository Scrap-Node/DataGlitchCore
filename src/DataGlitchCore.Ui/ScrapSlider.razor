@using System.Globalization
@* Curseur de réglage au balisage de scrap-slider (@scrap-node/scrap-ui) :
   étiquette et valeur au-dessus, bornes de part et d'autre, partie réglée
   en cuivre. S'utilise avec @bind-Value ; la valeur suit la saisie en
   continu, comme @bind:event="oninput" sur un input nu. *@
<div class="scrap-slider @(Disabled ? "scrap-slider--disabled" : null)">
    <div class="scrap-slider__top">
        <label for="@Id">@Label</label>
        <output class="scrap-slider__value" for="@Id">@(ValueText ?? Value.ToString(CultureInfo.CurrentCulture))</output>
    </div>
    <div class="scrap-slider__row">
        @if (MinLabel is not null)
        {
            <span class="scrap-slider__bound" aria-hidden="true">@MinLabel</span>
        }
        <div class="scrap-slider__track">
            <input id="@Id" class="scrap-range" type="range" min="@Min" max="@Max" step="@Step"
                   value="@Value" disabled="@Disabled" style="--fill:@Fill" aria-valuetext="@ValueText"
                   @oninput="OnInput" />
        </div>
        @if (MaxLabel is not null)
        {
            <span class="scrap-slider__bound" aria-hidden="true">@MaxLabel</span>
        }
    </div>
</div>

@code {
    /// <summary>Identifiant du curseur, qui relie l'étiquette et la valeur affichée.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    [Parameter] public int Min { get; set; }
    [Parameter] public int Max { get; set; } = 100;
    [Parameter] public int Step { get; set; } = 1;

    /// <summary>Valeur telle qu'affichée et annoncée : « 15 % », « 0xFF », « 2,0 s ».</summary>
    [Parameter] public string? ValueText { get; set; }

    [Parameter] public string? MinLabel { get; set; }
    [Parameter] public string? MaxLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Remplissage de la piste, ratio 0..1 pour la variable --fill de .scrap-range.</summary>
    private string Fill
    {
        get
        {
            if (Max <= Min) return "0";
            double t = Math.Clamp((Value - (double)Min) / (Max - Min), 0, 1);
            return t.ToString("0.####", CultureInfo.InvariantCulture);
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        // Un input range rend toujours un entier invariant : pas de culture ici.
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)) return;
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}
