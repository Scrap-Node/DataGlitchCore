@* Icône du set Scrap UI, au trait, en currentColor (classe .scrap-i de la
   feuille de la lib). Décorative par défaut ; Label la rend annoncée. *@
<svg class="scrap-i @Class" viewBox="0 0 20 20" width="@Size" height="@Size"
     aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")"
     aria-label="@Label" focusable="false">
    @if (Glyph.D is { } d)
    {
        <path d="@d" />
    }
    @if (Glyph.Dash is { } dash)
    {
        <path d="@dash" stroke-dasharray="2.4 2" />
    }
    @if (Glyph.Fill is { } fill)
    {
        <path d="@fill" fill="currentColor" stroke="none" />
    }
</svg>

@code {
    /// <summary>Nom de l'icône dans le set : <c>play</c>, <c>waveform</c>, <c>undo</c>…</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Taille en pixels. Absente : celle de la classe .scrap-i (18 px).</summary>
    [Parameter] public int? Size { get; set; }

    /// <summary>Texte alternatif. Absent : icône purement décorative.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Class { get; set; }

    private ScrapGlyph Glyph => ScrapIcons.Get(Name);
}
